/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  Origin-Agent-Cluster: ?1
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://zadeyo.com; img-src 'self' data: blob: https:; media-src 'self' blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; script-src-attr 'none'; connect-src 'self'; upgrade-insecure-requests; trusted-types default; require-trusted-types-for 'script'

/site.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400

/
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: public, s-maxage=600, stale-while-revalidate=86400
  Cloudflare-CDN-Cache-Control: public, s-maxage=600, stale-while-revalidate=86400

/*/
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: public, s-maxage=600, stale-while-revalidate=86400
  Cloudflare-CDN-Cache-Control: public, s-maxage=600, stale-while-revalidate=86400

/*.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: public, s-maxage=600, stale-while-revalidate=86400
  Cloudflare-CDN-Cache-Control: public, s-maxage=600, stale-while-revalidate=86400

/images/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/trusted-types-policy.js
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.webm
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: video/webm

/*.ico
  Cache-Control: public, max-age=31536000, immutable

/*.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

# Favicons LAST so these win over the immutable /*.png and /*.ico rules above.
# The bare /favicon.ico is auto-requested by browsers on non-HTML responses
# (e.g. /sitemap.xml) and can't be version-busted like the HTML <link> icons,
# so keep it short + revalidating to survive rebrands. favicon.ico ships PNG
# bytes, so its Content-Type is image/png (must match, given global nosniff).
/favicon.ico
  Content-Type: image/png
  Cache-Control: public, max-age=3600, must-revalidate

/favicon-16x16.png
  Content-Type: image/png
  Cache-Control: public, max-age=3600, must-revalidate

/favicon-32x32.png
  Content-Type: image/png
  Cache-Control: public, max-age=3600, must-revalidate

/favicon.png
  Content-Type: image/png
  Cache-Control: public, max-age=3600, must-revalidate

/apple-touch-icon.png
  Content-Type: image/png
  Cache-Control: public, max-age=3600, must-revalidate
