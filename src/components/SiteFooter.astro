---
import SiteFooterApp from './react/SiteFooter';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { getBlogBasePath } from '../data/blog/helpers';
import { getHtmlSitemapPath } from '../data/html-sitemap';
import { siteConfig, productInfo } from '../data/site';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;

const explore = [
	{ labelKey: 'nav.preview', href: getLocalizedPath('home', locale) },
	{ labelKey: 'nav.features', href: getLocalizedPath('features', locale) },
	{ labelKey: 'nav.pricing', href: getLocalizedPath('pricing', locale) },
	{ labelKey: 'nav.updates', href: getLocalizedPath('updates', locale) },
	{ labelKey: 'common.blog', href: getBlogBasePath(defaultLocale) },
	{ labelKey: 'nav.faq', href: getLocalizedPath('faq', locale) },
	{ labelKey: 'nav.esp', href: getLocalizedPath('tarkov-esp', locale) },
	{ labelKey: 'nav.aimbot', href: getLocalizedPath('tarkov-aimbot', locale) },
	{ labelKey: 'nav.radar', href: getLocalizedPath('radar', locale), fallback: 'Radar' },
];

const help = [
	{ labelKey: 'nav.setup', href: getLocalizedPath('setup', locale) },
	{ labelKey: 'nav.updates', href: getLocalizedPath('updates', locale) },
	{ labelKey: 'common.buyerReviewsNav', href: '/reviews/' },
	{ labelKey: 'common.support', href: getLocalizedPath('support', locale) },
	{ labelKey: 'common.sitemap', href: getHtmlSitemapPath(locale), fallback: 'Sitemap' },
	{ labelKey: 'common.privacy', href: getLocalizedPath('privacy', locale) },
	{ labelKey: 'common.terms', href: getLocalizedPath('terms', locale) },
];
---

<SiteFooterApp
	client:visible
	locale={locale}
	siteName={siteConfig.name}
	supportEmail={siteConfig.supportEmail}
	shareUrl={`${siteConfig.url}/`}
	checkoutUrl={siteConfig.checkoutUrl}
	storeHref={getLocalizedPath('pricing', locale)}
	tagline={productInfo.tagline}
	explore={explore}
	help={help}
/>

<style is:global>
	.site-footer {
		position: relative;
		background:
			linear-gradient(180deg, color-mix(in srgb, var(--magenta-soft) 6%, transparent) 0%, transparent 28%),
			linear-gradient(0deg, var(--bg-panel) 0%, var(--bg) 100%);
		border-top: 1px solid var(--line-soft);
		content-visibility: auto;
		contain-intrinsic-size: 1px 380px;
		overflow: hidden;
	}

	.site-footer__accent {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--magenta-soft) 22%, #f3efe6 50%, var(--magenta-soft) 78%, transparent);
		opacity: 0.45;
	}

	.site-footer__main {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(1.5rem, 4vw, 3rem);
		padding-block: clamp(2rem, 4vw, 2.75rem);
	}

	.site-footer__intro {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.85rem;
		padding-right: 1rem;
	}

	.site-footer__brand {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.1rem, 2.2vw, 1.35rem);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		line-height: 1.1;
	}

	.site-footer__brand-game {
		color: #f3efe6;
	}

	.site-footer__brand-rest {
		color: var(--magenta-soft);
	}

	.site-footer__tagline {
		margin: 0;
		max-width: 22rem;
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--ink-muted);
	}

	.site-footer__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin-top: 0.15rem;
	}

	.site-footer__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.35rem;
		padding: 0 1.1rem;
		border: 1px solid transparent;
		background: var(--accent);
		color: #121410;
		font-family: var(--font-display);
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-decoration: none;
		clip-path: polygon(6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%, 0 6px);
		transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
	}

	.site-footer__cta:hover {
		background: var(--accent-hover);
		color: #121410;
		transform: translateY(-1px);
	}

	.site-footer__cta--ghost {
		background: transparent;
		border-color: color-mix(in srgb, var(--magenta-soft) 45%, var(--line));
		color: #f3efe6;
	}

	.site-footer__cta--ghost:hover {
		border-color: var(--magenta-soft);
		color: #f3efe6;
		background: color-mix(in srgb, var(--magenta-soft) 10%, transparent);
	}

	.site-footer__social {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-top: 0.25rem;
	}

	.site-footer__social-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.15rem;
		height: 2.15rem;
		border: 1px solid var(--line);
		background: color-mix(in srgb, var(--bg-panel) 80%, transparent);
		color: var(--ink-muted);
		transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease, transform 0.15s ease;
	}

	.site-footer__social-btn svg {
		width: 0.95rem;
		height: 0.95rem;
		fill: currentColor;
	}

	.site-footer__social-btn:hover {
		border-color: var(--magenta-soft);
		color: var(--ink);
		background: color-mix(in srgb, var(--magenta-soft) 10%, var(--bg-panel));
		transform: translateY(-1px);
	}

	.site-footer__col {
		min-width: 0;
	}

	.site-footer__label {
		margin: 0 0 0.85rem !important;
		padding-bottom: 0.55rem;
		border-bottom: 1px solid color-mix(in srgb, var(--magenta-soft) 22%, var(--line-soft));
		font-family: var(--font-display);
		font-size: 0.6875rem !important;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--magenta-soft) !important;
	}

	.site-footer ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.45rem;
	}

	.site-footer__col a {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--ink-muted);
		text-decoration: none;
		transition: color 0.15s ease, transform 0.15s ease;
	}

	.site-footer__col a::before {
		content: '';
		width: 0.35rem;
		height: 1px;
		background: var(--magenta-soft);
		opacity: 0;
		transition: opacity 0.15s ease, width 0.15s ease;
	}

	.site-footer__col a:hover {
		color: #fff;
		transform: translateX(2px);
	}

	.site-footer__col a:hover::before {
		opacity: 1;
		width: 0.55rem;
	}

	.site-footer__bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 1.5rem;
		flex-wrap: wrap;
		border-top: 1px solid var(--line-soft);
		padding: 1rem 0 max(1.25rem, env(safe-area-inset-bottom, 0px));
	}

	.site-footer__bottom p {
		margin: 0;
		font-size: 0.6875rem;
		color: var(--ink-faint);
		letter-spacing: 0.04em;
	}

	.site-footer__legal {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem 1rem;
	}

	.site-footer__legal a {
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-faint);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.site-footer__legal a:hover {
		color: var(--ink);
	}

	@media (max-width: 900px) {
		.site-footer__main {
			grid-template-columns: 1fr 1fr;
		}

		.site-footer__intro {
			grid-column: 1 / -1;
			padding-right: 0;
			padding-bottom: 0.5rem;
			border-bottom: 1px solid var(--line-soft);
		}
	}

	@media (max-width: 640px) {
		.site-footer__main {
			grid-template-columns: 1fr;
			gap: 1.5rem;
			padding-block: 1.75rem;
		}

		.site-footer__intro {
			border-bottom: none;
			padding-bottom: 0;
		}

		.site-footer__actions {
			width: 100%;
		}

		.site-footer__cta {
			flex: 1 1 auto;
		}

		.site-footer__col a {
			min-height: 2.25rem;
		}

		.site-footer__bottom {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
