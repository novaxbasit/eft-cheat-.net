---
import { internalGuides } from '../../data/guides';
import { defaultLocale, type LocaleCode } from '../../data/i18n/locales';

interface Props {
	locale?: LocaleCode;
}

const { locale = defaultLocale } = Astro.props;
const title = locale === 'en' ? 'Guides' : 'Guides';
const linkLabel = locale === 'en' ? 'All guides' : 'Guides';
const homeCards = internalGuides.slice(0, 4);
---

<section class="pubg-section pubg-section--tight pubg-guides" aria-labelledby="pubg-guides-title">
	<div class="pubg-wrap">
		<header class="pubg-section__head">
			<h2 class="pubg-section__title" id="pubg-guides-title">{title}</h2>
			<a class="pubg-link" href="/guides/">{linkLabel}</a>
		</header>
		<div class="pubg-guides__grid">
			{
				homeCards.map((guide) => (
					<a class="pubg-guides__card pubg-panel pubg-panel--lift" href={guide.href}>
						<img src={guide.image} alt={guide.imageAlt} width="640" height="360" loading="lazy" decoding="async" />
						<div class="pubg-guides__body">
							<h3>{guide.title}</h3>
							<p>{guide.description}</p>
						</div>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.pubg-guides__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.75rem;
	}

	.pubg-guides__card {
		display: grid;
		grid-template-rows: auto 1fr;
		overflow: hidden;
		color: inherit;
		text-decoration: none;
	}

	.pubg-guides__card::before {
		display: none;
	}

	.pubg-guides__card img {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}

	.pubg-guides__body {
		display: grid;
		gap: 0.3rem;
		padding: 0.85rem 0.9rem 1rem;
	}

	.pubg-guides__body h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 0.92rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		color: #fff;
	}

	.pubg-guides__body p {
		margin: 0;
		font-size: 0.8rem;
		line-height: 1.45;
		color: var(--ink-muted);
	}

	@media (max-width: 960px) {
		.pubg-guides__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 560px) {
		.pubg-guides__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
