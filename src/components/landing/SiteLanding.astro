---
/**
 * Conversion landing — SEO schema lives in LocalizedHome.
 */
import SiteBanner from './SiteBanner.astro';
import InGameGallery from './InGameGallery.astro';
import HomeOverview from './HomeOverview.astro';
import PatchNotesSection from './PatchNotesSection.astro';
import { siteConfig, productInfo, homeFaqs, customerReviews } from '../../data/site';
import { brand, fillBrandTokens } from '../../data/brand';
import { getLocaleContent, getPageContent } from '../../data/i18n';
import { getLocalizedPath } from '../../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../../data/i18n/locales';
import { cloakEmailsInHtml } from '../../lib/support-email';
import { reviewsBasePath } from '../../data/reviews';

interface Props {
	locale?: LocaleCode;
}

const { locale = defaultLocale } = Astro.props;
const { ui } = getLocaleContent(locale);
const home = getPageContent(locale, 'home');
const faqPage = getPageContent(locale, 'faq');

const checkout = siteConfig.checkoutUrl;
const ctaLabel = locale === 'en' ? fillBrandTokens(brand.copy.ctaBuy) : home.ctaPrimary;
const heroSub = locale === 'en' ? (productInfo.heroLede ?? ui.hero.subtitle) : home.intro;
const seeCheatsHref = getLocalizedPath('features', locale);
const seeCheatsLabel = locale === 'en' ? 'See Features' : home.ctaSecondary ?? ui.hero.seeFeatures;
const faqHref = getLocalizedPath('faq', locale);
const reviewsHref = reviewsBasePath;
const reviewsTitle = locale === 'en' ? 'Reviews' : ui.reviews.title;
const reviewsLinkLabel = locale === 'en' ? 'All reviews' : ui.reviews.countLabel;
const faqTitle = ui.nav.faq;
const faqLinkLabel = locale === 'en' ? 'All FAQ' : ui.nav.faq;

const topReviews = customerReviews.slice(0, 3);
const topFaqs = homeFaqs;
---

<div class="site-landing">
	<section class="site-hero" aria-label={locale === 'en' ? productInfo.name : home.h1}>
		<SiteBanner priority>
			<div class="site-hero__inner">
				{
					locale === 'en' ? (
						<h1 class="site-hero__title" data-edit="heroH1">
							<span>Escape from Tarkov</span>
							<span class="site-hero__title-accent">Cheats</span>
						</h1>
					) : (
						<h1 class="site-hero__title site-hero__title--locale">{home.h1}</h1>
					)
				}
				<p class="site-hero__sub" data-edit="heroLede">{heroSub}</p>
				<div class="site-hero__cta">
					<a class="site-btn site-btn--lg" href={checkout} target="_blank" rel="noopener noreferrer" data-edit="ctaBuy">
						{ctaLabel}
					</a>
					<a class="site-play site-play--ghost" href={seeCheatsHref}>{seeCheatsLabel}</a>
				</div>
			</div>
		</SiteBanner>
	</section>

	<HomeOverview locale={locale} />

	<InGameGallery locale={locale} />

	<section class="site-section site-section--tight" aria-labelledby="site-reviews-title">
		<div class="site-wrap">
			<header class="site-section__head">
				<h2 class="site-section__title" id="site-reviews-title">{reviewsTitle}</h2>
				<a class="site-link" href={reviewsHref}>{reviewsLinkLabel}</a>
			</header>
			<div class="site-community">
				{
					topReviews.map((r) => (
						<article class="site-community__card">
							<div class="site-community__stars" aria-hidden="true">
								{'★'.repeat(r.rating)}
								{'☆'.repeat(5 - r.rating)}
							</div>
							<p class="site-community__text">{r.short}</p>
							<p class="site-community__author">{r.handle}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<PatchNotesSection locale={locale} />

	<section class="site-section site-section--faq" aria-labelledby="site-faq-title">
		<div class="site-wrap site-faq">
			<header class="site-section__head">
				<h2 class="site-section__title site-section__title--sm" id="site-faq-title">{faqTitle}</h2>
				<a class="site-link" href={faqHref}>{faqLinkLabel}</a>
			</header>
			{
				locale === 'en' ? (
					topFaqs.map((item) => (
						<details id={item.slug}>
							<summary>{item.question}</summary>
							<p class="site-faq__a" set:html={cloakEmailsInHtml(item.answer)} />
						</details>
					))
				) : (
					<p class="site-faq__lede">{faqPage.intro}</p>
				)
			}
		</div>
	</section>
</div>
