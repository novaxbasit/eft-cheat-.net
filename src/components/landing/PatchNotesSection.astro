---
import { trustSignals } from '../../data/site';
import { fillBrandTokens } from '../../data/brand';
import { getLocaleContent } from '../../data/i18n';
import { getLocalizedPath } from '../../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../../data/i18n/locales';
import { tarkovImages } from '../../data/tarkov';

interface Props {
	locale?: LocaleCode;
}

const { locale = defaultLocale } = Astro.props;
const { ui } = getLocaleContent(locale);
const updatesHref = getLocalizedPath('updates', locale);
const heading = locale === 'en' ? 'Updates' : ui.nav.updates;
const linkLabel = locale === 'en' ? 'Open Updates' : ui.nav.updates;
const note = locale === 'en' ? trustSignals.statusNote : ui.trust.statusNote;
const body =
	locale === 'en'
		? `${fillBrandTokens('See live notes on Updates after an {game} or {antiCheat} patch.')} ${note}`
		: note;
---

<section class="site-section site-section--tight" aria-labelledby="site-updates-title">
	<div class="site-wrap">
		<header class="site-section__head">
			<h2 class="site-section__title" id="site-updates-title">{heading}</h2>
			<a class="site-link" href={updatesHref}>{linkLabel}</a>
		</header>

		<a class="site-patch" href={updatesHref}>
			<div class="site-patch__img">
				<img
					src={tarkovImages.patchNotes}
					alt="Escape from Tarkov Cheats updates — live undetected notes after BattlEye patches"
					width="1024"
					height="576"
					loading="lazy"
					decoding="async"
				/>
			</div>
			<div class="site-patch__shade" aria-hidden="true"></div>
			<div class="site-patch__body">
				<div class="site-patch__tabs">
					<span class="site-patch__tab is-active">PC</span>
					<span class="site-patch__tab">{ui.trust.status}</span>
				</div>
				<p class="site-patch__p">{body}</p>
				<span class="site-patch__cta">{linkLabel}</span>
			</div>
		</a>
	</div>
</section>
