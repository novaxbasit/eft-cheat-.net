---
import { fillBrandTokens } from '../../data/brand';
import { getLocaleContent, getPageContent } from '../../data/i18n';
import { defaultLocale, type LocaleCode } from '../../data/i18n/locales';

interface Props {
	locale?: LocaleCode;
}

const { locale = defaultLocale } = Astro.props;
const { ui } = getLocaleContent(locale);
const home = getPageContent(locale, 'home');
const overviewTitle = locale === 'en' ? "What's included" : home.sections[1]?.h2 ?? ui.nav.features;
---

<section class="site-section site-overview" aria-labelledby="site-overview-title">
	<div class="site-wrap site-overview__inner">
		<div class="site-overview__header">
			<h2 class="site-section__title" id="site-overview-title">{overviewTitle}</h2>
			{
				locale === 'en' ? (
					<div class="site-overview__lead">
						<p>
							{fillBrandTokens(
								'Check Updates after a {game} or {antiCheat} patch before you raid.',
							)}
						</p>
						<p class="site-overview__lead-sub">
							{fillBrandTokens(
								'The overlay is streamproof, so ESP and menus stay off OBS. Player ESP, loot ESP, and aimbot work in one menu. Cloud DMA is required for full functionality.',
							)}
						</p>
					</div>
				) : (
					<div class="site-overview__lead">
						<p>{home.intro}</p>
					</div>
				)
			}
		</div>

		{
			locale === 'en' ? (
				<div class="site-overview__grid">
			<article class="site-overview__card">
				<div class="site-overview__card-head">
					<span class="site-overview__icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
							<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
							<circle cx="12" cy="12" r="3" />
						</svg>
					</span>
					<h3>Player ESP</h3>
				</div>
				<p>
					Player ESP shows PMCs, bosses, bots, and Scavs with box, skeleton, chams, health, nickname, weapon, and distance.
					Quest marks and radar sit in the same overlay.
				</p>
				<ul class="site-overview__list">
					<li>Box, skeleton, chams, and health</li>
					<li>Boss, bot, Scav, and quest ESP</li>
					<li>Exfils, transitions, and radar</li>
				</ul>
			</article>

			<article class="site-overview__card">
				<div class="site-overview__card-head">
					<span class="site-overview__icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
							<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
							<path d="M3.3 7 12 12l8.7-5M12 22V12" />
						</svg>
					</span>
					<h3>Loot ESP and world</h3>
				</div>
				<p>
					Loot ESP filters items by category, price, and distance. Containers, stashes, corpses, and computers can show too.
					Weather, fog, and rain sit under World.
				</p>
				<ul class="site-overview__list">
					<li>Loot names, price, and filters</li>
					<li>Containers, stashes, and corpses</li>
					<li>Streamproof overlay for captures</li>
				</ul>
			</article>

			<article class="site-overview__card">
				<div class="site-overview__card-head">
					<span class="site-overview__icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
							<circle cx="12" cy="12" r="10" />
							<path d="M12 2v20M2 12h20" />
							<circle cx="12" cy="12" r="3" />
						</svg>
					</span>
					<h3>Aimbot and combat tools</h3>
				</div>
				<p>
					Aimbot includes FOV, vis check, smart bone, prediction, and lock. No recoil and no sway sit in Misc with thermal and third person.
				</p>
				<ul class="site-overview__list">
					<li>FOV, vis check, and prediction</li>
					<li>No recoil, no sway, and instant ADS</li>
					<li>Hotkeys and config saves</li>
				</ul>
			</article>

			<article class="site-overview__card">
				<div class="site-overview__card-head">
					<span class="site-overview__icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
							<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
							<path d="m9 12 2 2 4-4" />
						</svg>
					</span>
					<h3>Plans, delivery, and updates</h3>
				</div>
				<p>
					Monthly ($35 / 31 days) and lifetime ($150) include the same features. Raids only — Arena is a separate key. Cloud DMA is required for full functionality.
				</p>
				<ul class="site-overview__list">
					<li>Instant delivery after checkout</li>
					<li><a href="/pricing/">Pricing</a> · <a href="/updates/">Updates</a> · <a href="/blog/">Blog</a></li>
					<li><a href="/setup/">Setup</a> after you buy</li>
				</ul>
			</article>
				</div>
			) : (
				<div class="site-overview__grid">
					{
						home.sections.map((section) => (
							<article class="site-overview__card">
								<h3>{section.h2}</h3>
								{section.paragraphs.map((paragraph) => (
									<p set:html={paragraph} />
								))}
							</article>
						))
					}
				</div>
			)
		}
	</div>
</section>
