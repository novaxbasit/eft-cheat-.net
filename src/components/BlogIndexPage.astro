---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import SiteFooter from './SiteFooter.astro';
import InnerPageBanner from './landing/InnerPageBanner.astro';
import { blogUi, type LocaleCode, defaultLocale } from '../data/i18n/locales';
import {
	absoluteBlogUrl,
	getAllPostsForLocale,
	getBlogBasePath,
	getBlogIndexHreflangAlternates,
} from '../data/blog/helpers';
import { siteConfig } from '../data/site';
import { brandSeo, seoPageTitle } from '../data/site-core';
import { seoDescription } from '../data/brand';
import { getLocalizedPath } from '../data/i18n/routing';

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const ui = blogUi[locale];
const posts = getAllPostsForLocale(locale);
const canonicalPath = getBlogBasePath(locale);
const canonicalURL = absoluteBlogUrl(locale);
const hreflangAlternates = getBlogIndexHreflangAlternates(locale);
const homeHref = getLocalizedPath('home', locale);

const pageTitle = locale === defaultLocale ? seoPageTitle(brandSeo.blogTitle) : ui.blogTitle;
const pageDescription =
	locale === defaultLocale ? seoDescription(brandSeo.blogDescription) : ui.blogDescription;

const articleListSchema = {
	'@type': 'CollectionPage',
	'@id': `${canonicalURL}#collection`,
	name: ui.blogH1,
	description: pageDescription,
	url: canonicalURL,
	inLanguage: locale,
	isPartOf: { '@id': `${siteConfig.url}/#website` },
	mainEntity: {
		'@type': 'ItemList',
		itemListElement: posts.map((post, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			url: absoluteBlogUrl(locale, post.translation.slug),
			name: post.translation.title,
		})),
	},
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalPath={canonicalPath}
	hreflangAlternates={hreflangAlternates}
	locale={locale}
	ogImage={siteConfig.defaultOgImage}
	ogImageAlt={ui.blogH1}
	breadcrumbs={[{ label: ui.home, href: homeHref }, { label: ui.blogH1 }]}
	extraGraph={[articleListSchema]}
>
	<Navbar locale={locale} />
	<main class="pubg-page blog">
		<InnerPageBanner title={ui.blogH1} intro={ui.blogIntro} />

		<div class="shell pubg-page__body blog__inner">
		<section class="blog__list" aria-label={ui.allPosts}>
			{
				posts.map((post, index) => (
					<article class="blog__card pubg-panel pubg-panel--lift">
						<a href={post.canonicalPath}>
							<img
								src={post.imageSrc}
								alt={post.translation.imageAlt}
								width="480"
								height="270"
								loading={index === 0 ? 'eager' : 'lazy'}
								decoding="async"
								fetchpriority={index === 0 ? 'high' : undefined}
							/>
							<span class="blog__cat">{post.category}</span>
							<h2>{post.translation.title}</h2>
							<p>{post.translation.intro}</p>
							<span class="blog__meta">
								{ui.updated} {post.updated}
							</span>
						</a>
					</article>
				))
			}
		</section>
		</div>
	</main>
	<SiteFooter locale={locale} />
</Layout>

<style>
	.blog__inner {
		display: grid;
		gap: 1.5rem;
	}
	.blog__featured {
		display: grid;
		gap: 1.25rem;
		margin-bottom: 2.5rem;
	}
	.blog__feature-card {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.2fr);
		gap: 1rem;
		padding: 0;
		overflow: hidden;
		text-decoration: none;
		color: inherit;
	}
	.blog__feature-card img {
		width: 100%;
		height: 100%;
		max-height: 240px;
		object-fit: cover;
	}
	.blog__feature-card h2 {
		margin: 0.4rem 0 0.6rem;
		font-size: 1.35rem;
		color: var(--heading);
	}
	.blog__list {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
		gap: 1.25rem;
	}
	.blog__card a {
		display: block;
		height: 100%;
		padding: 0.75rem;
		text-decoration: none;
		color: inherit;
	}
	.blog__card img {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		margin-bottom: 0.75rem;
	}
	.blog__card h2 {
		margin: 0.35rem 0 0.5rem;
		font-size: 1.05rem;
		line-height: 1.25;
		color: var(--heading);
	}
	.blog__card p,
	.blog__feature-card p {
		margin: 0;
		color: rgba(255, 255, 255, 0.68);
		font-size: 0.92rem;
	}
	.blog__cat {
		display: inline-block;
		color: var(--magenta-soft);
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
	.blog__more,
	.blog__meta {
		display: inline-block;
		margin-top: 0.75rem;
		color: rgba(255, 255, 255, 0.55);
		font-size: 0.8rem;
		font-weight: 600;
	}
	.blog__more {
		color: var(--magenta-soft);
	}
	@media (max-width: 760px) {
		.blog__feature-card {
			grid-template-columns: 1fr;
		}

		.blog__list {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.blog__card a {
			padding: 0.75rem;
		}
	}

	@media (max-width: 480px) {
		.blog__feature-card h2 {
			font-size: 1.2rem;
		}
	}
</style>
