---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import SiteFooter from './SiteFooter.astro';
import InnerPageBanner from './landing/InnerPageBanner.astro';
import { blogUi, type LocaleCode, defaultLocale } from '../data/i18n/locales';
import {
	absoluteBlogUrl,
	getAllPostsForLocale,
	getBlogBasePath,
	getBlogIndexHreflangAlternates,
} from '../data/blog/helpers';
import { siteConfig } from '../data/site';
import { brandSeo, seoPageTitle } from '../data/site-core';
import { seoDescription } from '../data/brand';
import { getLocalizedPath } from '../data/i18n/routing';
import { getThreadMeta } from '../data/forum';

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const ui = blogUi[locale];
const posts = getAllPostsForLocale(locale);
const canonicalPath = getBlogBasePath(locale);
const canonicalURL = absoluteBlogUrl(locale);
const hreflangAlternates = getBlogIndexHreflangAlternates(locale);
const homeHref = getLocalizedPath('home', locale);

const pageTitle = locale === defaultLocale ? seoPageTitle(brandSeo.blogTitle) : ui.blogTitle;
const pageDescription =
	locale === defaultLocale ? seoDescription(brandSeo.blogDescription) : ui.blogDescription;

const articleListSchema = {
	'@type': 'CollectionPage',
	'@id': `${canonicalURL}#collection`,
	name: ui.blogH1,
	description: pageDescription,
	url: canonicalURL,
	inLanguage: locale,
	isPartOf: { '@id': `${siteConfig.url}/#website` },
	mainEntity: {
		'@type': 'ItemList',
		itemListElement: posts.map((post, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			url: absoluteBlogUrl(locale, post.translation.slug),
			name: post.translation.title,
		})),
	},
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalPath={canonicalPath}
	hreflangAlternates={hreflangAlternates}
	locale={locale}
	ogImage={siteConfig.defaultOgImage}
	ogImageAlt={ui.blogH1}
	breadcrumbs={[{ label: ui.home, href: homeHref }, { label: ui.blogH1 }]}
	extraGraph={[articleListSchema]}
>
	<Navbar locale={locale} />
	<main class="site-page forum">
		<InnerPageBanner title={ui.blogH1} intro={ui.blogIntro} />

		<div class="shell site-page__body forum__inner">
			<p class="forum__notice" role="note">
				<span class="forum__notice-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8">
						<rect x="5" y="11" width="14" height="9" rx="1.5" />
						<path d="M8 11V8a4 4 0 0 1 8 0v3" />
					</svg>
				</span>
				This forum is archived. Threads below are read-only — replies are closed.
			</p>
			<section class="forum__board" aria-label={ui.allPosts}>
				<div class="forum__head" aria-hidden="true">
					<span>Thread</span>
					<span class="forum__head-stat">Replies</span>
					<span class="forum__head-stat">Views</span>
					<span class="forum__head-stat">Last reply</span>
				</div>
				{
					posts.map((post) => {
						const meta = getThreadMeta(post.id + post.translation.slug, post.translation.slug);
						return (
							<a class="forum__row" href={post.canonicalPath}>
								<span class="forum__row-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7">
										<rect x="5" y="11" width="14" height="9" rx="1.5" />
										<path d="M8 11V8a4 4 0 0 1 8 0v3" />
									</svg>
								</span>
								<span class="forum__row-main">
									<span class="forum__cat">{post.category}</span>
									<span class="forum__title">{post.translation.title}</span>
									<span class="forum__snippet">{post.translation.intro}</span>
									<span class="forum__tags">
										<span class="forum__pill forum__pill--closed">Closed</span>
										<span class="forum__by">by {meta.op.handle}</span>
									</span>
								</span>
								<span class="forum__stat"><b>{meta.replyCount}</b><small>replies</small></span>
								<span class="forum__stat"><b>{meta.views.toLocaleString('en-US')}</b><small>views</small></span>
								<span class="forum__stat forum__stat--date"><b>{post.updated}</b><small>{ui.updated}</small></span>
							</a>
						);
					})
				}
			</section>
		</div>
	</main>
	<SiteFooter locale={locale} />
</Layout>

<style>
	.forum__inner {
		display: grid;
		gap: 1rem;
	}

	.forum__notice {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0;
		padding: 0.75rem 1rem;
		border: 1px solid color-mix(in srgb, var(--magenta-soft) 30%, var(--line));
		background: color-mix(in srgb, var(--magenta-soft) 8%, var(--bg-panel));
		color: rgba(255, 255, 255, 0.82);
		font-size: 0.9rem;
	}
	.forum__notice-icon {
		display: inline-flex;
		color: var(--magenta-soft);
	}

	.forum__board {
		border: 1px solid var(--line);
		background: var(--bg-panel);
	}

	.forum__head {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 5.5rem 6rem 8rem;
		gap: 1rem;
		padding: 0.6rem 1rem;
		border-bottom: 1px solid var(--line);
		background: color-mix(in srgb, #fff 3%, var(--bg-panel));
		font-family: var(--font-display);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}
	.forum__head-stat {
		text-align: center;
	}

	.forum__row {
		display: grid;
		grid-template-columns: 1.75rem minmax(0, 1fr) 5.5rem 6rem 8rem;
		gap: 1rem;
		align-items: center;
		padding: 0.85rem 1rem;
		border-bottom: 1px solid var(--line-soft);
		text-decoration: none;
		color: inherit;
		transition: background 0.15s ease;
	}
	.forum__row:last-child {
		border-bottom: none;
	}
	.forum__row:hover {
		background: color-mix(in srgb, var(--magenta-soft) 6%, transparent);
	}
	.forum__row-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: var(--ink-faint);
	}
	.forum__head {
		padding-left: calc(1rem + 1.75rem + 1rem);
	}

	.forum__row-main {
		min-width: 0;
		display: grid;
		gap: 0.2rem;
	}
	.forum__cat {
		color: var(--magenta-soft);
		font-size: 0.68rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
	.forum__title {
		font-size: 1.02rem;
		font-weight: 700;
		line-height: 1.25;
		color: var(--heading);
	}
	.forum__row:hover .forum__title {
		color: #fff;
	}
	.forum__snippet {
		color: rgba(255, 255, 255, 0.6);
		font-size: 0.86rem;
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 1;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.forum__tags {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 0.15rem;
	}
	.forum__pill {
		display: inline-flex;
		align-items: center;
		padding: 0.1rem 0.45rem;
		font-size: 0.66rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		border: 1px solid var(--line);
		color: var(--ink-faint);
	}
	.forum__pill--closed {
		color: #f0b23a;
		border-color: color-mix(in srgb, #f0b23a 45%, var(--line));
		background: color-mix(in srgb, #f0b23a 10%, transparent);
	}
	.forum__by {
		font-size: 0.76rem;
		color: var(--ink-faint);
	}

	.forum__stat {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.1rem;
		text-align: center;
	}
	.forum__stat b {
		font-size: 0.95rem;
		color: var(--ink);
		font-variant-numeric: tabular-nums;
	}
	.forum__stat small {
		font-size: 0.66rem;
		color: var(--ink-faint);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	@media (max-width: 760px) {
		.forum__head {
			display: none;
		}
		.forum__row {
			grid-template-columns: 1.5rem minmax(0, 1fr) auto;
			grid-template-areas:
				'icon main main'
				'icon stats stats';
			gap: 0.5rem 0.85rem;
		}
		.forum__row-icon {
			grid-area: icon;
			align-self: start;
			margin-top: 0.2rem;
		}
		.forum__row-main {
			grid-area: main;
		}
		.forum__stat {
			display: none;
		}
		.forum__snippet {
			-webkit-line-clamp: 2;
		}
	}
</style>
