---
import NavbarApp from './react/Navbar';
import {
	getLocalizedPath,
	getPageLocaleSwitchHref,
	resolvePageContextFromPath,
	type PageId,
} from '../data/i18n/routing';
import { defaultLocale, locales, type LocaleCode } from '../data/i18n/locales';
import { reviewsBasePath } from '../data/reviews';
import { siteConfig } from '../data/site';
import { getBlogBasePath } from '../data/blog/helpers';
import { getBlogLocaleSwitchHref, isBlogPath } from '../data/blog/helpers';

interface Props {
	locale?: LocaleCode;
	pageId?: PageId;
}

const { locale = defaultLocale, pageId: pageIdProp } = Astro.props;
const pathContext = resolvePageContextFromPath(Astro.url.pathname);
const pageId = pageIdProp ?? pathContext.pageId ?? 'home';
const current = Astro.url.pathname;
const onBlog = isBlogPath(current);

const pageContext = onBlog
	? pathContext
	: {
			...pathContext,
			pageId: pathContext.pageId ?? pageId,
		};

function localeSwitchHref(targetLocale: LocaleCode): string {
	if (onBlog) return getBlogLocaleSwitchHref(current, targetLocale);
	return getPageLocaleSwitchHref(pageContext, targetLocale);
}

const hrefForLocale = Object.fromEntries(
	locales.map((l) => [l.code, localeSwitchHref(l.code)]),
) as Record<string, string>;

const localeMetas = locales.map((l) => ({
	code: l.code,
	name: l.name,
	nativeName: l.nativeName,
	hreflang: l.hreflang,
	region: l.region,
}));

const links = [
	{ id: 'hacks', labelKey: 'nav.preview', edit: 'navPreview', href: getLocalizedPath('hacks', locale) },
	{ id: 'features', labelKey: 'nav.features', edit: 'navFeatures', href: getLocalizedPath('features', locale) },
	{ id: 'pricing', labelKey: 'nav.pricing', edit: 'navStore', href: getLocalizedPath('pricing', locale) },
	{ id: 'updates', labelKey: 'nav.updates', edit: 'navStatus', href: getLocalizedPath('updates', locale) },
	{ id: 'blog', labelKey: 'common.blog', href: getBlogBasePath(defaultLocale) },
	{ id: 'faq', labelKey: 'nav.faq', href: getLocalizedPath('faq', locale) },
	{ id: 'setup', labelKey: 'nav.setup', href: getLocalizedPath('setup', locale) },
	{ id: 'support', labelKey: 'common.support', href: getLocalizedPath('support', locale) },
];

const hasHeroBanner = !current.includes('/brand-studio');
---

<NavbarApp
	client:load
	locale={locale}
	siteName={siteConfig.name}
	checkoutUrl={siteConfig.checkoutUrl}
	currentPath={current}
	homeHref={getLocalizedPath('home', locale)}
	reviewsBasePath={reviewsBasePath}
	locales={localeMetas}
	hrefForLocale={hrefForLocale}
	links={links}
	hasHeroBanner={hasHeroBanner}
/>

<script>
	import { initNavbarScrollSync } from '../lib/navbar-scroll';

	initNavbarScrollSync();
</script>

<style is:global>
	body.nav-lock {
		overflow: hidden;
	}

	.site-header,
	.site-header__bar,
	.site-tools,
	.site-tools__lang {
		overflow: visible;
	}

	.site-header .lang-switcher {
		position: relative;
		display: inline-flex;
		align-items: center;
		height: 2rem;
		margin: 0;
		padding: 0;
	}

	.site-header summary.lang-switcher__toggle {
		display: block;
		margin: 0;
		padding: 0;
		border: none;
		background: none;
		list-style: none;
		cursor: pointer;
		-webkit-appearance: none;
		appearance: none;
	}

	.site-header summary.lang-switcher__toggle::-webkit-details-marker {
		display: none;
	}

	.site-tools__pill {
		box-sizing: border-box;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		height: 2rem;
		min-height: 2rem;
		max-height: 2rem;
		padding-block: 0;
		padding-inline: 0.65rem;
		margin: 0;
		border: 1px solid transparent;
		border-radius: 2px;
		font-family: var(--font-display);
		font-size: 0.625rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		line-height: 1;
		white-space: nowrap;
		flex-shrink: 0;
		text-decoration: none;
		cursor: pointer;
		-webkit-backdrop-filter: blur(14px) saturate(1.2);
		backdrop-filter: blur(14px) saturate(1.2);
	}

	.site-tools__pill > span {
		display: block;
		line-height: 1;
	}

	.site-tools__pill svg {
		width: 0.85rem;
		height: 0.85rem;
		flex-shrink: 0;
		opacity: 0.75;
	}

	.site-tools__pill--ghost {
		border-color: color-mix(in srgb, var(--line) 80%, transparent);
		background: color-mix(in srgb, var(--bg-elevated) 72%, transparent);
		color: var(--ink-muted);
		transition:
			color 0.15s ease,
			background 0.15s ease,
			border-color 0.15s ease;
	}

	.site-tools__pill--ghost:hover {
		color: var(--ink);
		border-color: var(--line);
		background: color-mix(in srgb, var(--bg-elevated) 88%, transparent);
	}

	.site-tools__pill--buy {
		border-color: color-mix(in srgb, var(--accent) 70%, var(--line));
		background: color-mix(in srgb, var(--accent) 92%, transparent);
		color: #121410;
		transition: background 0.15s ease, border-color 0.15s ease;
	}

	.site-tools__pill--buy:hover {
		background: color-mix(in srgb, var(--accent-hover) 94%, transparent);
		border-color: var(--accent-hover);
		color: #121410;
	}

	.site-header .site-tools__buy.pubg-btn,
	.site-header .site-tools__buy.btn-buy,
	.site-header a.site-tools__buy {
		min-width: 0 !important;
		width: auto;
		height: 2rem !important;
		min-height: 2rem !important;
		max-height: 2rem !important;
		padding-block: 0 !important;
		padding-inline: 0.65rem !important;
		font-size: 0.625rem !important;
		line-height: 1 !important;
		clip-path: none !important;
		box-shadow: none !important;
		transform: none !important;
	}

	.site-header .lang-switcher__panel {
		position: absolute;
		right: 0;
		left: auto;
		top: calc(100% + 0.45rem);
		width: min(16rem, calc(100vw - 2rem));
		min-width: 15rem;
		max-height: min(70vh, 22rem);
		overflow: auto;
		overscroll-behavior: contain;
		padding: 0.5rem;
		background: var(--bg-elevated);
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		box-shadow: 0 20px 48px rgba(0, 0, 0, 0.5);
		z-index: 120;
	}

	.site-header .lang-switcher__link {
		color: var(--ink);
	}

	.site-header .lang-switcher__link:hover,
	.site-header .lang-switcher__link.is-current {
		background: color-mix(in srgb, var(--accent) 12%, transparent);
	}

	.site-header.is-transparent .site-tools__pill--ghost {
		border-color: rgba(255, 255, 255, 0.22);
		background: color-mix(in srgb, var(--bg) 38%, transparent);
		color: rgba(255, 255, 255, 0.88);
	}

	.site-header.is-transparent .site-tools__pill--ghost:hover {
		border-color: rgba(255, 255, 255, 0.36);
		background: color-mix(in srgb, var(--bg) 52%, transparent);
		color: #fff;
	}

	.site-header.is-transparent .site-tools__pill--buy {
		background: color-mix(in srgb, var(--accent) 90%, transparent);
		border-color: color-mix(in srgb, var(--accent) 65%, rgba(255, 255, 255, 0.25));
	}

	.site-header.is-transparent .site-menu {
		border-color: rgba(255, 255, 255, 0.22);
		background: color-mix(in srgb, var(--bg) 38%, transparent);
		color: rgba(255, 255, 255, 0.9);
	}

	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 200;
		padding-top: var(--safe-top, env(safe-area-inset-top, 0px));
		background: color-mix(in srgb, var(--bg) 78%, transparent);
		border-bottom: 1px solid transparent;
		backdrop-filter: blur(14px) saturate(1.2);
		-webkit-backdrop-filter: blur(14px) saturate(1.2);
		transition:
			background 0.25s ease,
			border-color 0.25s ease,
			box-shadow 0.25s ease,
			backdrop-filter 0.25s ease,
			-webkit-backdrop-filter 0.25s ease;
	}

	.site-header.is-transparent {
		background: color-mix(in srgb, var(--bg) 16%, transparent) !important;
		border-bottom-color: rgba(255, 255, 255, 0.1) !important;
		box-shadow: none !important;
		backdrop-filter: blur(20px) saturate(1.35) !important;
		-webkit-backdrop-filter: blur(20px) saturate(1.35) !important;
	}

	body:has(.pubg-page__banner) .site-header.is-transparent:not(:has(.site-nav-drawer[open])),
	body:has(.pubg-hero) .site-header.is-transparent:not(:has(.site-nav-drawer[open])) {
		background: color-mix(in srgb, var(--bg) 12%, transparent) !important;
		border-bottom-color: rgba(255, 255, 255, 0.08) !important;
		box-shadow: none !important;
		backdrop-filter: blur(22px) saturate(1.45) !important;
		-webkit-backdrop-filter: blur(22px) saturate(1.45) !important;
	}

	.site-header.is-scrolled,
	.site-header.is-open,
	.site-header:has(.site-nav-drawer[open]) {
		background: color-mix(in srgb, var(--bg) 72%, transparent);
		border-bottom-color: color-mix(in srgb, var(--magenta-soft) 28%, var(--line-soft));
		box-shadow: 0 4px 24px rgba(0, 0, 0, 0.35);
		backdrop-filter: blur(18px) saturate(1.25);
		-webkit-backdrop-filter: blur(18px) saturate(1.25);
	}

	.site-header__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: var(--header-h);
		gap: 0.75rem;
	}

	.site-brand {
		display: flex;
		align-items: baseline;
		gap: 0.3rem;
		min-width: 0;
		flex: 0 1 auto;
		margin-right: 0.75rem;
		font-family: var(--font-display);
		font-size: 0.875rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #f3efe6;
		text-decoration: none;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.site-brand__game {
		color: #f3efe6;
	}

	.site-brand__rest {
		color: var(--magenta-soft);
	}

	.site-brand:hover .site-brand__rest {
		color: #fff;
	}

	.site-nav {
		display: flex;
		align-items: center;
		justify-content: flex-start;
		gap: 0.15rem;
		flex: 1;
		min-width: 0;
		margin-inline: 0.75rem;
		padding: 0;
		border: none;
		border-radius: 0;
		background: transparent;
		box-shadow: none;
	}

	.site-nav a {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.4rem 0.65rem;
		border-radius: 0;
		font-family: var(--font-display);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.65);
		white-space: nowrap;
		transition: color 0.15s ease;
	}

	.site-nav a:hover {
		color: #fff;
		background: transparent;
	}

	.site-nav a.is-active {
		color: #f3efe6;
		background: transparent;
		box-shadow: inset 0 -2px 0 var(--accent);
	}

	@media (min-width: 1025px) {
		.site-nav a svg {
			display: none;
		}
	}

	.site-tools {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.4rem;
		margin-left: auto;
		min-width: 0;
		position: relative;
		z-index: 2;
	}

	.site-tools__pair {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	.site-tools__lang {
		display: inline-flex;
		align-items: center;
	}

	.site-menu {
		display: none;
		align-items: center;
		justify-content: center;
		width: var(--touch-min, 2.75rem);
		height: var(--touch-min, 2.75rem);
		padding: 0;
		border: 1px solid var(--line);
		border-radius: 2px;
		background: var(--bg-elevated);
		color: var(--ink);
		flex-shrink: 0;
		cursor: pointer;
		touch-action: manipulation;
		-webkit-tap-highlight-color: transparent;
		position: relative;
		z-index: 202;
		list-style: none;
	}

	.site-menu::-webkit-details-marker {
		display: none;
	}

	.site-nav-drawer {
		display: none;
		position: relative;
	}

	.site-menu__bars {
		display: grid;
		gap: 3.5px;
		width: 0.95rem;
	}

	.site-menu__bars span {
		display: block;
		height: 1.5px;
		border-radius: 999px;
		background: currentColor;
		transition:
			transform 0.2s ease,
			opacity 0.2s ease;
		transform-origin: center;
	}

	.site-header.is-open .site-menu__bars span:nth-child(1),
	.site-nav-drawer[open] .site-menu__bars span:nth-child(1) {
		transform: translateY(5px) rotate(45deg);
	}

	.site-header.is-open .site-menu__bars span:nth-child(2),
	.site-nav-drawer[open] .site-menu__bars span:nth-child(2) {
		opacity: 0;
	}

	.site-header.is-open .site-menu__bars span:nth-child(3),
	.site-nav-drawer[open] .site-menu__bars span:nth-child(3) {
		transform: translateY(-5px) rotate(-45deg);
	}

	@keyframes panel-in {
		from {
			opacity: 0;
			transform: translateY(-4px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 1200px) {
		.site-nav a {
			padding-inline: 0.5rem;
			font-size: 0.6875rem;
		}
	}

	@media (max-width: 1280px) {
		.site-nav {
			display: none;
			position: fixed;
			top: calc(var(--header-h) + var(--safe-top, env(safe-area-inset-top, 0px)));
			left: 0;
			right: 0;
			z-index: 201;
			flex: none;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			margin: 0;
			max-height: calc(100dvh - var(--header-h) - var(--safe-top, env(safe-area-inset-top, 0px)));
			overflow-y: auto;
			-webkit-overflow-scrolling: touch;
			border-top: 1px solid var(--line-soft);
			background: var(--bg);
			padding: 0.35rem 0 max(1.35rem, env(safe-area-inset-bottom, 0px));
			animation: panel-in 0.18s ease-out;
		}

		.site-header:has(.site-nav-drawer[open]) .site-nav {
			display: grid;
		}

		.site-header:has(.site-nav-drawer[open]) .site-nav a {
			display: flex;
			align-items: center;
			gap: 0.75rem;
			min-height: var(--touch-min, 2.75rem);
			padding: 0.85rem 1.25rem;
			font-size: 0.9375rem;
			font-weight: 500;
			letter-spacing: -0.015em;
			text-transform: none;
			color: var(--ink-muted);
			border-bottom: 1px solid var(--line-soft);
			white-space: normal;
		}

		.site-header:has(.site-nav-drawer[open]) .site-nav a svg {
			display: block;
			width: 1.1rem;
			height: 1.1rem;
			color: var(--magenta-soft);
			opacity: 0.9;
		}

		.site-header:has(.site-nav-drawer[open]) .site-nav a:hover,
		.site-header:has(.site-nav-drawer[open]) .site-nav a.is-active {
			color: var(--ink);
		}

		.site-header:has(.site-nav-drawer[open]) .site-nav a.is-active {
			color: var(--magenta-soft);
		}

		.site-nav-drawer {
			display: block;
			order: 3;
		}

		.site-tools__pair {
			height: auto;
		}

		.site-tools__lang {
			display: none;
		}

		.site-brand {
			display: block;
			flex: 1 1 auto;
			min-width: 0;
			max-width: none;
		}

		.site-header__bar {
			justify-content: space-between;
			gap: 0.55rem;
		}

		.site-tools {
			order: 2;
		}

		.site-tools__buy,
		.site-tools__pill {
			min-height: var(--touch-min, 2.75rem);
			height: var(--touch-min, 2.75rem);
			max-height: var(--touch-min, 2.75rem);
			padding-inline: 0.85rem;
			font-size: 0.8rem;
			flex-shrink: 0;
		}

		.site-menu {
			display: inline-flex;
		}

		.site-header.is-open {
			background: var(--bg);
		}

		.site-header:has(.site-nav-drawer[open]) {
			background: color-mix(in srgb, var(--bg) 94%, transparent);
		}
	}

	@media (max-width: 480px) {
		.site-brand {
			font-size: 0.72rem;
		}

		.site-tools {
			gap: 0.4rem;
		}

		.site-tools__buy,
		.site-tools__pill {
			padding-inline: 0.7rem;
		}
	}

	@media (max-width: 360px) {
		.site-tools__buy span {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
			border: 0;
		}

		.site-tools__buy {
			padding-inline: 0.7rem;
			min-width: var(--touch-min);
			justify-content: center;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header,
		.site-nav a,
		.site-tools__buy,
		.site-menu__bars span {
			transition: none;
			animation: none;
		}

		.site-tools__buy:hover,
		.site-tools__pill--buy:hover {
			transform: none;
		}
	}
</style>
