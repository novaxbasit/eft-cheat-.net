---
import Layout from './Layout.astro';
import Navbar from '../components/Navbar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import InnerPageBanner from '../components/landing/InnerPageBanner.astro';
import InGameGallery from '../components/landing/InGameGallery.astro';
import { getUi } from '../data/i18n';
import { getLocalizedPath, resolvePageContextFromPath, type PageId } from '../data/i18n/routing';
import { tarkovImages } from '../data/tarkov';
import { defaultLocale } from '../data/i18n/locales';
import { siteConfig } from '../data/site';
import { getT } from '../i18n/server';

interface Props {
	title: string;
	description: string;
	canonicalPath?: string;
	heading: string;
	intro: string;
	eyebrow?: string;
	heroImage?: string;
	heroAlt?: string;
	gallery?: ReadonlyArray<string | { src: string; alt: string }>;
	galleryTitle?: string;
	ctaPrimary?: { href: string; label: string; edit?: string };
	ctaSecondary?: { href: string; label: string };
	introEdit?: string;
	showGallery?: boolean;
	galleryPosition?: 'top' | 'bottom';
	locale?: import('../data/i18n/locales').LocaleCode;
	pageId?: import('../data/i18n/content.generated').PageId;
	extraGraph?: Record<string, unknown>[];
}

const {
	title,
	description,
	canonicalPath = '/',
	heading,
	intro,
	heroImage = tarkovImages.hero,
	heroAlt,
	ctaPrimary,
	ctaSecondary,
	introEdit,
	showGallery = false,
	galleryPosition = 'top',
	locale = defaultLocale,
	pageId: pageIdProp,
	extraGraph = [],
} = Astro.props;

const t = getT(locale);
const resolvedHeroAlt =
	(heroAlt && heroAlt.trim()) ||
	t('images.hero') ||
	`${siteConfig.name} — Escape from Tarkov ESP and aimbot`;

function resolvePageId(path: string): PageId | undefined {
	return resolvePageContextFromPath(path).pageId;
}

const pageId = pageIdProp ?? resolvePageId(canonicalPath);
const ui = getUi(locale);
const homeHref = getLocalizedPath('home', locale);

const breadcrumbs = [
	{ label: ui.nav.home, href: homeHref },
	{ label: heading },
];

const showGalleryTop = showGallery && galleryPosition !== 'bottom';
const showGalleryBottom = showGallery && galleryPosition === 'bottom';
---

<Layout
	title={title}
	description={description}
	canonicalPath={canonicalPath}
	ogImage={heroImage}
	ogImageAlt={resolvedHeroAlt}
	breadcrumbs={breadcrumbs}
	locale={locale}
	pageId={pageId}
	extraGraph={extraGraph}
	lcpImage="/images/hero-banner.webm"
	lcpImageSizes="100vw"
>
	<Navbar locale={locale} pageId={pageId} />
	<main class="pubg-page">
		<InnerPageBanner
			title={heading}
			intro={intro}
			introEdit={introEdit}
			ctaPrimary={ctaPrimary}
			ctaSecondary={ctaSecondary}
		/>

		{showGalleryTop && <InGameGallery locale={locale} />}

		<div class="shell pubg-page__body">
			<article class="pubg-article">
				<slot />
			</article>
		</div>

		{showGalleryBottom && <InGameGallery locale={locale} />}
	</main>
	<SiteFooter locale={locale} />
</Layout>
