---
import '../styles/global.css';
import '../styles/site-home.css';
import '../styles/site-pages.css';
import '../styles/scroll-reveal.css';
import { brand } from '../data/brand';
import { productInfo, siteConfig } from '../data/site';
import ScrollReveal from '../components/ScrollReveal.astro';
import MobileNavFallback from '../components/MobileNavFallback.astro';
import { brandTheme, brandThemeInlineStyle, brandThemeRootCss } from '../data/brand-theme';
import I18nHead from '../components/I18nHead.astro';
import InlineBrandEditor from '../components/InlineBrandEditor.astro';
import { heroMimeType, heroVideoMimeType } from '../lib/responsive-images';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import type { PageId } from '../data/i18n/content.generated';
import { buildCanonicalUrl, type HreflangAlternate } from '../data/i18n/routing';

interface Crumb {
	label: string;
	href?: string;
}

interface Props {
	title: string;
	description: string;
	canonicalPath?: string;
	ogImage?: string;
	ogImageAlt?: string;
	noindex?: boolean;
	type?: 'website' | 'article';
	breadcrumbs?: Crumb[];
	locale?: LocaleCode;
	pageId?: PageId;
	hreflangAlternates?: HreflangAlternate[];
	extraGraph?: Record<string, unknown>[];
	lcpImage?: string;
	lcpImageSrcSet?: string;
	lcpImageSizes?: string;
}

const {
	title,
	description,
	canonicalPath = Astro.url.pathname,
	ogImage = siteConfig.defaultOgImage,
	ogImageAlt = title,
	noindex = false,
	type = 'website',
	breadcrumbs,
	locale = defaultLocale,
	pageId,
	hreflangAlternates,
	extraGraph = [],
	lcpImage,
	lcpImageSrcSet,
	lcpImageSizes = '100vw',
} = Astro.props;

const canonicalURL = buildCanonicalUrl(canonicalPath);
const faviconQuery = `?v=${brand.faviconVersion}`;
const ogImageURL = new URL(ogImage, siteConfig.url).href;
const logoURL = new URL(siteConfig.logoRaster, siteConfig.url).href;
const ogImageIsLogo = ogImage === siteConfig.logo;
const ogImageType = ogImage.endsWith('.webp') ? 'image/webp' : ogImage.endsWith('.jpg') || ogImage.endsWith('.jpeg') ? 'image/jpeg' : 'image/png';
const ogImageWidth = ogImageIsLogo ? String(siteConfig.logoRasterWidth) : ogImage.includes('hero-1024w') ? '1024' : '1024';
const ogImageHeight = ogImageIsLogo ? String(siteConfig.logoRasterHeight) : ogImage.includes('hero-1024w') ? '409' : ogImage.includes('patch-notes') ? '576' : '576';
const twitterCard = ogImageIsLogo ? 'summary' : 'summary_large_image';
const robots = noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const siteDescription = `${productInfo.tagline}. ${productInfo.summary}`;
const schemaLanguage = 'en';

const graph: Record<string, unknown>[] = [
	{
		'@type': 'WebPage',
		'@id': `${canonicalURL}#webpage`,
		url: canonicalURL,
		name: title,
		description,
		isPartOf: { '@id': `${siteConfig.url}/#website` },
		inLanguage: schemaLanguage,
		primaryImageOfPage: {
			'@type': 'ImageObject',
			url: ogImageURL,
			name: ogImageAlt,
			description: ogImageAlt,
			width: Number(ogImageWidth),
			height: Number(ogImageHeight),
		},
	},
	{
		'@type': 'WebSite',
		'@id': `${siteConfig.url}/#website`,
		url: siteConfig.url,
		name: siteConfig.name,
		description: siteDescription,
		inLanguage: schemaLanguage,
		publisher: { '@id': `${siteConfig.url}/#organization` },
		logo: {
			'@type': 'ImageObject',
			url: logoURL,
			width: siteConfig.logoRasterWidth,
			height: siteConfig.logoRasterHeight,
		},
	},
	{
		'@type': 'Organization',
		'@id': `${siteConfig.url}/#organization`,
		name: siteConfig.name,
		url: siteConfig.url,
		email: siteConfig.supportEmail,
		logo: {
			'@type': 'ImageObject',
			url: logoURL,
			width: siteConfig.logoRasterWidth,
			height: siteConfig.logoRasterHeight,
		},
		image: logoURL,
		contactPoint: {
			'@type': 'ContactPoint',
			contactType: 'customer support',
			email: siteConfig.supportEmail,
			availableLanguage: 'English',
		},
	},
];

if (breadcrumbs && breadcrumbs.length > 0) {
	graph.push({
		'@type': 'BreadcrumbList',
		'@id': `${canonicalURL}#breadcrumb`,
		itemListElement: breadcrumbs.map((crumb, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			name: crumb.label,
			...(crumb.href
				? { item: new URL(crumb.href, siteConfig.url).href }
				: { item: canonicalURL }),
		})),
	});
}

if (extraGraph.length > 0) {
	// Nodes must not carry a nested @context inside @graph (invalid JSON-LD).
	graph.push(
		...extraGraph.map((node) => {
			const { ['@context']: _ignored, ...rest } = node as Record<string, unknown> & {
				'@context'?: unknown;
			};
			return rest;
		}),
	);
}

const softwareNode = extraGraph.find((node) => node['@type'] === 'SoftwareApplication');
const productNode = extraGraph.find((node) => node['@type'] === 'Product');
const aboutNode = softwareNode ?? productNode;
if (aboutNode) {
	const webpage = graph.find((node) => node['@type'] === 'WebPage') as Record<string, unknown> | undefined;
	if (webpage) {
		webpage.about = { '@id': aboutNode['@id'] };
	}
}
---

<!doctype html>
<html lang="en" dir="ltr" style={brandThemeInlineStyle()}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content={brandTheme.bg} />
		<link
			rel="preload"
			as="font"
			type="font/woff2"
			href="/fonts/inter-latin-wght-normal.woff2"
			crossorigin
		/>
		<link
			rel="preload"
			as="font"
			type="font/woff2"
			href="/fonts/syne-latin-wght-normal.woff2"
			crossorigin
		/>
		{/* Self-hosted Inter + Syne (latin) — no Google Fonts. */}
		<script is:inline src="/trusted-types-policy.js"></script>
		<meta name="robots" content={robots} />
		<meta name="googlebot" content={robots} />
		<meta name="description" content={description} />
		<meta name="author" content={siteConfig.name} />
		<link rel="canonical" href={canonicalURL} />
		{
			lcpImage?.endsWith('.webm') ? (
				<link
					rel="preload"
					as="video"
					href={lcpImage}
					type={heroVideoMimeType}
					fetchpriority="high"
				/>
			) : lcpImageSrcSet ? (
				<link
					rel="preload"
					as="image"
					href={lcpImage ?? lcpImageSrcSet.split(' ')[0]}
					type={lcpImage?.endsWith('.png') ? 'image/png' : heroMimeType}
					fetchpriority="high"
					imagesrcset={lcpImageSrcSet}
					imagesizes={lcpImageSizes}
				/>
			) : (
				lcpImage && (
					<link
						rel="preload"
						as="image"
						href={lcpImage}
						type={lcpImage.endsWith('.png') ? 'image/png' : heroMimeType}
						fetchpriority="high"
					/>
				)
			)
		}
		{pageId && <I18nHead pageId={pageId} locale={locale} />}
		{
			!pageId &&
				hreflangAlternates?.map((alt) => (
					<link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
				))
		}

		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={siteConfig.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:secure_url" content={ogImageURL} />
		<meta property="og:image:type" content={ogImageType} />
		<meta property="og:image:width" content={ogImageWidth} />
		<meta property="og:image:height" content={ogImageHeight} />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:locale" content="en" />

		<meta name="twitter:card" content={twitterCard} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		{!noindex && (
			<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
		)}

		<title>{title}</title>
		<link rel="icon" href={`/favicon.ico${faviconQuery}`} sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href={`/favicon-32x32.png${faviconQuery}`} />
		<link rel="icon" type="image/png" sizes="16x16" href={`/favicon-16x16.png${faviconQuery}`} />
		<link rel="icon" type="image/png" sizes="192x192" href={`/favicon.png${faviconQuery}`} />
		<link rel="shortcut icon" href={`/favicon.ico${faviconQuery}`} />
		<link rel="apple-touch-icon" sizes="180x180" href={`/apple-touch-icon.png${faviconQuery}`} />
		<link rel="manifest" href={`/site.webmanifest${faviconQuery}`} />
		<link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
	</head>
	<body>
		<MobileNavFallback />
		<slot />
		<ScrollReveal />
		<InlineBrandEditor />
		{/* After Vite/Tailwind CSS so brand tokens win over @theme defaults */}
		<style id="brand-theme-vars" set:html={brandThemeRootCss()}></style>
	</body>
</html>
