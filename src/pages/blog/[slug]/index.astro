---
import BlogPostPage from '../../../components/BlogPostPage.astro';
import { blogPosts, blogSlugRedirects, getPostBySlug, resolvePost } from '../../../data/blog/helpers';
import { defaultLocale } from '../../../data/i18n/locales';

export function getStaticPaths() {
	const posts = blogPosts.map((post) => {
		const resolved = resolvePost(post, defaultLocale);
		return {
			params: { slug: resolved.translation.slug },
			props: { post: resolved, redirectTo: undefined as string | undefined },
		};
	});

	const redirects = Object.entries(blogSlugRedirects).map(([from, to]) => ({
		params: { slug: from },
		props: { post: undefined, redirectTo: to },
	}));

	return [...posts, ...redirects];
}

const { post, redirectTo } = Astro.props;

if (redirectTo || !post) {
	return Astro.redirect(redirectTo ? `/blog/${redirectTo}/` : '/blog/', 301);
}

const live = getPostBySlug(defaultLocale, post.translation.slug) ?? post;
---

<BlogPostPage locale="en" post={live} />
