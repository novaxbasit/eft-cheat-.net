---
import { blogPosts, blogSlugRedirects, resolvePost } from '../../../data/blog/helpers';
import { defaultLocale } from '../../../data/i18n/locales';

/** Legacy /blog/<slug>/ — permanent redirect to /forum/<slug>/ (or slug remap). */
export function getStaticPaths() {
	const posts = blogPosts.map((post) => {
		const resolved = resolvePost(post, defaultLocale);
		return {
			params: { slug: resolved.translation.slug },
			props: { redirectTo: resolved.translation.slug },
		};
	});

	const redirects = Object.entries(blogSlugRedirects).map(([from, to]) => ({
		params: { slug: from },
		props: { redirectTo: to },
	}));

	return [...posts, ...redirects];
}

const { redirectTo } = Astro.props as { redirectTo?: string };
return Astro.redirect(redirectTo ? `/forum/${redirectTo}/` : '/forum/', 301);
---
